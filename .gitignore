.DS_Store
__pycache__/
*.pyc

# Run output. Regenerated by running the pipeline; every stage caches per task,
# so nothing here is worth versioning.
results/

# The table collections themselves (~9 GB), downloaded from Drive into
# datasets/<Dataset>/. Only the benchmark definitions and Beaver's profiling
# files are committed.
datasets/*/input_tables/
datasets/*/answer/
datasets/*/tables_rels/

# Beaver's column profiling (81 MB, dominated by dev_jaccard.json). Ships with
# the dataset download, next to the tables.
datasets/*/profiles/

# Local scratch
*.bak
*.bak-*
